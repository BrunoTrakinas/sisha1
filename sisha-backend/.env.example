# SISHA1 V2 - exemplo de configuracao do backend.
# NUNCA copie valores reais para este arquivo.

NODE_ENV=development
PORT=3000

# Origem(ns) permitida(s), separadas por virgula.
# Exemplo local: http://localhost:5173
# Exemplo producao: https://seu-frontend.netlify.app
CORS_ORIGINS=http://localhost:5173

# URL publica do frontend usada SOMENTE nos links de primeiro acesso/recuperacao.
# Em producao deve ser a URL HTTPS real do SISHA, sem barra final.
AUTH_FRONTEND_URL=http://localhost:5173

# Supabase
SUPABASE_URL=

# Chave publica/anon: usada SOMENTE pelos fluxos publicos do Supabase Auth
# executados pelo backend (login, validacao de sessao e recuperacao de senha).
# Nao usar esta chave para ler/escrever o schema public do SISHA.
SUPABASE_KEY=

# Obrigatoria para o data-plane do SISHA e administracao do Auth.
# Deve existir apenas no backend/servidor e nunca no frontend.
SUPABASE_SECRET_KEY=
# Compatibilidade legada, somente se ainda necessaria:
# SUPABASE_SERVICE_ROLE_KEY=

# H4C6 - Supabase Auth e o unico autenticador. Nao ha senha/token local legado.

# Chat Lince / OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
CHAT_LINCE_SITE_URL=http://localhost:5173
OPENROUTER_PDF_ENGINE=cloudflare-ai
OPENROUTER_PDF_MAX_MB=50
WTP_MAX_FILE_MB=50
WTP_PREVIEW_CACHE_MINUTES=30

# Cloudflare R2 - manuais tecnicos
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_MANUALS_BUCKET=
# Mantido apenas se o ambiente atual ainda utilizar esta variavel:
R2_Token_value=

# H4B - RPCs ACID do nucleo de Equipamentos.
# No ambiente homologado H4B/H4C, manter true.
SISHA_H4B_ACID_EQUIPMENT_ENABLED=true


# H4D - gate de producao
# Em NODE_ENV=production o backend falha fechado se:
# - CORS_ORIGINS estiver vazio, usar wildcard, HTTP ou localhost;
# - AUTH_FRONTEND_URL nao usar HTTPS;
# - SUPABASE_URL / SUPABASE_KEY / SUPABASE_SECRET_KEY estiverem ausentes;
# - SISHA_H4B_ACID_EQUIPMENT_ENABLED nao estiver true.
#
# APP_AUTH_SECRET e SISHA_AUTH_MODE sao obsoletos desde H4C6 e nao devem existir.


# H6A - Gateway de seguranca do Chat Lince
CHAT_LINCE_MAX_PROMPT_CHARS=6000


# H6D - Protecao contra abuso/custo do Chat Lince
# Defaults conservadores; ajuste somente com evidencias de uso real.
CHAT_LINCE_CONSULT_WINDOW_MS=60000
CHAT_LINCE_CONSULT_MAX=20
CHAT_LINCE_CONSULT_BURST_WINDOW_MS=10000
CHAT_LINCE_CONSULT_BURST_MAX=5
CHAT_LINCE_CONSULT_USER_CONCURRENCY=2
CHAT_LINCE_CONSULT_GLOBAL_CONCURRENCY=8

CHAT_LINCE_DOCUMENT_ANALYSIS_WINDOW_MS=600000
CHAT_LINCE_DOCUMENT_ANALYSIS_MAX=5
CHAT_LINCE_DOCUMENT_ANALYSIS_BURST_WINDOW_MS=60000
CHAT_LINCE_DOCUMENT_ANALYSIS_BURST_MAX=2
CHAT_LINCE_DOCUMENT_ANALYSIS_USER_CONCURRENCY=1
CHAT_LINCE_DOCUMENT_ANALYSIS_GLOBAL_CONCURRENCY=2

CHAT_LINCE_RAG_REINDEX_WINDOW_MS=900000
CHAT_LINCE_RAG_REINDEX_MAX=2
CHAT_LINCE_RAG_REINDEX_BURST_WINDOW_MS=300000
CHAT_LINCE_RAG_REINDEX_BURST_MAX=1
CHAT_LINCE_RAG_REINDEX_USER_CONCURRENCY=1
CHAT_LINCE_RAG_REINDEX_GLOBAL_CONCURRENCY=1

CHAT_LINCE_ACTION_CONFIRM_WINDOW_MS=900000
CHAT_LINCE_ACTION_CONFIRM_MAX=10
CHAT_LINCE_ACTION_CONFIRM_BURST_WINDOW_MS=60000
CHAT_LINCE_ACTION_CONFIRM_BURST_MAX=4
CHAT_LINCE_ACTION_CONFIRM_USER_CONCURRENCY=1
CHAT_LINCE_ACTION_CONFIRM_GLOBAL_CONCURRENCY=4

CHAT_LINCE_REAUTH_FAILURE_WINDOW_MS=900000
CHAT_LINCE_REAUTH_MAX_FAILURES=5
CHAT_LINCE_REAUTH_LOCK_MS=900000


# H6E - Gate final de seguranca da IA
# false: SISHA pode iniciar mesmo sem OpenRouter e usar fallback quando suportado.
# true: em producao, ausencia de OPENROUTER_API_KEY vira NO_GO.
CHAT_LINCE_REQUIRE_LIVE_AI=false

# Em producao, prefira OPENROUTER_MODEL explicitamente definido em vez de openrouter/auto.

# C2.7 - OCR local deterministico para documentos comerciais escaneados
# PN/preco de carta Repair/Overhaul nao dependem de IA generativa.
SISHA_LOCAL_OCR_ENABLED=true
SISHA_TESSERACT_CMD=tesseract
SISHA_PDFTOPPM_CMD=pdftoppm
SISHA_LOCAL_OCR_TIMEOUT_MS=45000
SISHA_LOCAL_OCR_MAX_PAGES=4
